// --- ESP-NOW CONTROLLER STRUCT ---
typedef struct struct_message {
  int speedLeft;     
  int speedRight;    
  bool lmb;          
  bool rmb;
  bool mmb;
  bool isFrozen;     
} struct_message;

struct_message gloveData;

