const int MOTOR_IN2       = 26;
const int MOTOR_IN3       = 27;
const int MOTOR_IN4       = 33;

const int FAN_RELAY_PIN   = 18;
const int SOUND_PIN       = 34;

// --- RELAY LOGIC (Active HIGH for K2272) ---
#define RELAY_ON  HIGH   
#define RELAY_OFF LOW   

// --- SYSTEM STATES ---
enum SystemState {
  STATE_STANDBY,          // Idle: Fan OFF, normal face, listening for claps / Wi-Fi / ESP-NOW
  STATE_EXTRACTING_FUMES // Fan ON, animated fan eyes, listening for 3 claps
};

SystemState currentState = STATE_STANDBY;

// --- SOUND SENSOR TRACKING ---
unsigned long lastSoundTime = 0;
int soundCount = 0;
const int clapWindow = 800; // Time window (ms) to group claps

