// --- ESP-NOW RECEIVER CALLBACK ---
void OnDataRecv(const esp_now_recv_info_t *recv_info, const uint8_t *incomingData, int len) {
  if (len == sizeof(struct_message)) {
    memcpy(&gloveData, incomingData, sizeof(gloveData));
    lastEspNowPacketTime = millis();

    if (gloveData.isFrozen) {
      espNowManualCmd = "STOP";
    } else if (gloveData.speedLeft > 50 && gloveData.speedRight > 50) {
      espNowManualCmd = "FORWARD";
    } else if (gloveData.speedLeft < -50 && gloveData.speedRight < -50) {
      espNowManualCmd = "BACK";
    } else if (gloveData.speedLeft < -20 && gloveData.speedRight > 20) {
      espNowManualCmd = "LEFT";
    } else if (gloveData.speedLeft > 20 && gloveData.speedRight < -20) {
      espNowManualCmd = "RIGHT";
    } else {
      espNowManualCmd = "STOP";
    }

    // Toggle fan if glove LMB is pressed down
    if (gloveData.lmb) {
      bool currentFanState = digitalRead(FAN_RELAY_PIN);
      digitalWrite(FAN_RELAY_PIN, !currentFanState);
      currentState = (!currentFanState == RELAY_ON) ? STATE_EXTRACTING_FUMES : STATE_STANDBY;
      delay(300); // Debounce trigger
    }

    if (!controllerKnown && recv_info->src_addr != NULL) {
      memcpy(controllerMac, recv_info->src_addr, 6);
      esp_now_peer_info_t peerInfo = {};
      memcpy(peerInfo.peer_addr, controllerMac, 6);
      peerInfo.channel = 0;
      peerInfo.encrypt = false;
      if (esp_now_add_peer(&peerInfo) == ESP_OK) {
        controllerKnown = true;
      }
    }

    if (controllerKnown) {
      strncpy(robotIdentity.name, ROBOT_NAME, sizeof(robotIdentity.name));
      esp_now_send(controllerMac, (uint8_t *)&robotIdentity, sizeof(robotIdentity));
    }
  }
}

// --- MOTOR CONTROL FUNCTIONS ---
void stopMotors() {
  digitalWrite(MOTOR_IN1, LOW);
  digitalWrite(MOTOR_IN2, LOW);
  digitalWrite(MOTOR_IN3, LOW);
  digitalWrite(MOTOR_IN4, LOW);
}

void driveForward() {
  digitalWrite(MOTOR_IN1, HIGH);
  digitalWrite(MOTOR_IN2, LOW);
  digitalWrite(MOTOR_IN3, HIGH);
  digitalWrite(MOTOR_IN4, LOW);
}

void driveBackward() {
  digitalWrite(MOTOR_IN1, LOW);
  digitalWrite(MOTOR_IN2, HIGH);
  digitalWrite(MOTOR_IN3, LOW);
  digitalWrite(MOTOR_IN4, HIGH);
}

void turnLeft() {
  digitalWrite(MOTOR_IN1, LOW);
  digitalWrite(MOTOR_IN2, HIGH);
  digitalWrite(MOTOR_IN3, HIGH);
  digitalWrite(MOTOR_IN4, LOW);
}

void turnRight() {
  digitalWrite(MOTOR_IN1, HIGH);
  digitalWrite(MOTOR_IN2, LOW);
  digitalWrite(MOTOR_IN3, LOW);
  digitalWrite(MOTOR_IN4, HIGH);
}

// Pulsed safe drive to prevent voltage drop and brownouts
void safeDrive(bool isForward, int durationMs) {
  if (isForward) driveForward();
  else driveBackward();
  
  unsigned long start = millis();
  while (millis() - start < durationMs) {
    yield(); 
  }
  stopMotors();
  delay(150); // Power rail recovery buffer
}

// --- DISPLAY EXPRESSIONS ---
void drawNormalFace() {
  display.ssd1306_command(SSD1306_DISPLAYON);
  display.clearDisplay();
  display.fillRoundRect(28, 24, 22, 26, 6, SSD1306_WHITE);
  display.fillRoundRect(78, 24, 22, 26, 6, SSD1306_WHITE);
  display.display();
}

void drawSurprisedFace() {
  display.ssd1306_command(SSD1306_DISPLAYON);
  display.clearDisplay();
  display.fillTriangle(24, 10, 50, 10, 37, 6, SSD1306_WHITE); 
  display.fillTriangle(78, 10, 104, 10, 91, 6, SSD1306_WHITE);
  display.fillCircle(37, 34, 14, SSD1306_WHITE);
  display.fillCircle(91, 34, 14, SSD1306_WHITE);
  display.display();
}

void animateFanEyes() {
  Wire.begin(); // Re-initialize I2C bus in case motor noise hit communication lines
  display.ssd1306_command(SSD1306_DISPLAYON);
  
  float angle = 0;
  unsigned long startAnim = millis();

  while (millis() - startAnim < 1500) {
    display.clearDisplay();
    for (int eye = 0; eye < 2; eye++) {
      int cx = (eye == 0) ? 37 : 91;
      int cy = 32;
      int r = 16;

      display.drawCircle(cx, cy, r, SSD1306_WHITE);
      display.fillCircle(cx, cy, 3, SSD1306_WHITE); 

      for (int i = 0; i < 4; i++) {
        float rad = (angle + (i * 90)) * 0.0174533; 
        int x2 = cx + cos(rad) * (r - 2);
        int y2 = cy + sin(rad) * (r - 2);
        display.drawLine(cx, cy, x2, y2, SSD1306_WHITE);
      }
    }
    display.display();
    angle += 25; 
    if (angle >= 360) angle = 0;
    delay(40);
  }
}

void turnOffDisplay() {
  display.clearDisplay();
  display.display();
  display.ssd1306_command(SSD1306_DISPLAYOFF);
}

// Victory dance sequence
void performDance() {
  for (int i = 0; i < 4; i++) {
    int dir = random(0, 2);          
    safeDrive(dir == 0, 200);
    delay(150);
  }
  stopMotors(); 
}

// --- WEB SERVER ROUTE HANDLERS ---
void handleRoot() {
  server.send(200, "text/html", HTML_PAGE);
}

void handleCommand() {
  if (server.hasArg("action")) {
    String action = server.arg("action");
    if (action == "FORWARD") driveForward();
    else if (action == "BACK") driveBackward();
    else if (action == "LEFT") turnLeft();
    else if (action == "RIGHT") turnRight();
    else if (action == "STOP") stopMotors();
    else if (action == "TOGGLE_FAN") {
      bool currentFanState = digitalRead(FAN_RELAY_PIN);
      digitalWrite(FAN_RELAY_PIN, !currentFanState);
      currentState = (!currentFanState == RELAY_ON) ? STATE_EXTRACTING_FUMES : STATE_STANDBY;
    }
  }
  server.send(200, "text/plain", "OK");
}

// --- SETUP ---
void setup() {
  // Disable brownout detector to allow motor current surges without CPU reset
  WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0);

  Serial.begin(115200);
  Wire.setTimeOut(1000);

  pinMode(FAN_RELAY_PIN, OUTPUT);
  digitalWrite(FAN_RELAY_PIN, RELAY_OFF);

  pinMode(MOTOR_IN1, OUTPUT);
  pinMode(MOTOR_IN2, OUTPUT);
  pinMode(MOTOR_IN3, OUTPUT);
  pinMode(MOTOR_IN4, OUTPUT);
  stopMotors();

  pinMode(SOUND_PIN, INPUT);

  randomSeed(analogRead(36));

  if (display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    drawNormalFace();
  }
  
  // Start Wi-Fi Access Point & ESP-NOW
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(AP_SSID, AP_PASS);

  if (esp_now_init() == ESP_OK) {
    esp_now_register_recv_cb(OnDataRecv);
    Serial.println("ESP-NOW Ready!");
  }

  server.on("/", handleRoot);
  server.on("/cmd", handleCommand);
  server.begin();

  Serial.println(">>> Engineering Helper Ready. Standby Mode (Listening for Claps, Wi-Fi, & ESP-NOW)...");
}

// --- MAIN LOOP ---
void loop() {
  unsigned long currentMillis = millis();
  int soundState = digitalRead(SOUND_PIN);

  // Handle incoming web client requests
  server.handleClient();

  // Determine active remote motion command (Web or ESP-NOW glove)
  String activeMotionCmd = "STOP";
  if (currentMillis - lastEspNowPacketTime < 500) {
    activeMotionCmd = espNowManualCmd;
  }

  // Execute remote movement if triggered via ESP-NOW
  if (activeMotionCmd == "FORWARD") driveForward();
  else if (activeMotionCmd == "BACK") driveBackward();
  else if (activeMotionCmd == "LEFT") turnLeft();
  else if (activeMotionCmd == "RIGHT") turnRight();
  else if (activeMotionCmd == "STOP" && currentMillis - lastEspNowPacketTime >= 500) {
    // Only release manual control back to idle if no active web override is happening
  }

  // 1. Read sound sensor with debounce
  if (soundState == HIGH) {
    if (currentMillis - lastSoundTime > 250) {  
      soundCount++;
      lastSoundTime = currentMillis;
      Serial.print("Clap Detected! Count: ");
      Serial.println(soundCount);
    }
  }

  // 2. Evaluate clap window when user pauses clapping
  if (soundCount > 0 && (currentMillis - lastSoundTime > clapWindow)) {
    
    // --- TRIGGER 1: 2 CLAPS IN STANDBY MODE ---
    if (currentState == STATE_STANDBY && soundCount == 2) {
      soundCount = 0;
      Serial.println(">>> 2 Claps Confirmed! Executing Drive + Fan Routine...");

      drawSurprisedFace();
      delay(1000);

      // Drive forward 200ms
      safeDrive(true, 200); 
      delay(200);

      // Play fan animation & dim screen to save logic power
      animateFanEyes();
      turnOffDisplay();
      delay(500);

      // Turn ON the solder fume extractor fan relay
      digitalWrite(FAN_RELAY_PIN, RELAY_ON);
      currentState = STATE_EXTRACTING_FUMES;
      
      Serial.println(">>> Fan ACTIVE. State shifted to STATE_EXTRACTING_FUMES (Listening for 3 Claps)...");
    }
    
    // --- TRIGGER 2: 3 CLAPS WHILE FAN IS RUNNING ---
    else if (currentState == STATE_EXTRACTING_FUMES && soundCount >= 3) {
      soundCount = 0;
      Serial.println(">>> 3 Claps Confirmed! Turning Fan OFF + Performing Victory Dance...");

      // Shut off the fan relay
      digitalWrite(FAN_RELAY_PIN, RELAY_OFF);
      
      drawSurprisedFace();
      delay(1000);

      // Perform victory dance
      performDance();
      stopMotors();

      // Return to Standby with normal face
      drawNormalFace();
      currentState = STATE_STANDBY;
      
      Serial.println(">>> Dance Complete. Back in Standby Mode.");
    }
    
    // --- INVALID CLAP COUNT RESET ---
    else {
      soundCount = 0; // Clear unexpected clap counts
    }
  }
}
